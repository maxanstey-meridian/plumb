<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- analyzer packaging: no lib output, dll under analyzers/dotnet/cs -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <PackageId>Meridian.Analyzers</PackageId>
    <Version>0.1.0</Version>
    <Authors>Meridian</Authors>
    <Description>Build-time mirror of plumb's Meridian module-boundary rules (MER-BE-001/002/005): Domain purity, Application never touches Infrastructure, never cross module boundaries — always Common. Source of truth: ~/.meridian/plumb (FABLE_CONTRACT.md §11.4).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>

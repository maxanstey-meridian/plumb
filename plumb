#!/usr/bin/env node
// plumb — mechanical Meridian-doctrine checker.
// The runner only: detects conventions → runs producers → merges findings → exits.
import { spawnSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import { performance } from "node:perf_hooks";
import { fileURLToPath } from "node:url";
import { createVisibility, shouldIncludeFile } from "./checks/_lib/fs-scan.mjs";
import { planCapabilities } from "./lib/engine/contracts.mjs";
import { createRepositorySnapshot } from "./lib/engine/repository-snapshot.mjs";
import { runInProcessRules } from "./lib/engine/run-rules.mjs";
import { inProcessRules } from "./lib/in-process-rules/index.mjs";
import { createRepositoryInventory, writeInventoryManifest } from "./lib/repository-inventory.mjs";
import { detectRivetContext } from "./lib/rivet-context.mjs";
import { loadRuleOwners } from "./lib/rule-catalog.mjs";

const invocationStarted = performance.now();

const HOME = path.dirname(fileURLToPath(import.meta.url));
const SGCONFIG = path.join(HOME, "sgconfig.yml");
const CHECKS = path.join(HOME, "checks");
const RULES = path.join(HOME, "rules");
const FIXTURES = path.join(HOME, "fixtures");
const SEV = { error: 3, warn: 2, info: 1 };
const PACKS = new Set(["BE", "BT", "CP", "FE", "RV", "TE", "TO"]);

const args = process.argv.slice(2);

// `plumb init …` is the project composer (writes a fresh doctrine-perfect repo);
// every other invocation is the read-only checker below. The no-fixer ruling
// holds: plumb never fixes a repo it checks — init only CREATES (create ≠ fix).
if (args[0] === "init") {
  const { runInit } = await import(path.join(HOME, "init.mjs"));
  runInit(args.slice(1));
  process.exit(0);
}

let root = null, json = false, failOn = "error", selfTest = false, ruleFilter = null, packFilter = null, ci = false, profile = false;
let baselineFile = null, writeBaselineFile = null;
const usage = "usage: plumb <repo-root> [--json] [--profile] [--fail-on error|warn|info] [--rule MER-XX-NNN] [--pack FE,BE,...] [--ci] [--baseline file | --write-baseline file] | plumb --self-test";
const requireValue = (flag, index) => {
  const value = args[index + 1];
  if (!value || value.startsWith("--")) {
    console.error(`plumb: ${flag} requires a value\n${usage}`);
    process.exit(2);
  }
  return value;
};
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === "--json") json = true;
  else if (a === "--profile") profile = true;
  else if (a === "--self-test") selfTest = true;
  else if (a === "--ci") ci = true;
  else if (a === "--fail-on") failOn = requireValue(a, i++);
  else if (a === "--rule") ruleFilter = requireValue(a, i++);
  else if (a === "--pack") packFilter = new Set(requireValue(a, i++).split(","));
  else if (a === "--baseline") baselineFile = requireValue(a, i++);
  else if (a === "--write-baseline") writeBaselineFile = requireValue(a, i++);
  else if (a.startsWith("-")) {
    console.error(`plumb: unknown option ${a}\n${usage}`);
    process.exit(2);
  }
  else root = a;
}
if (!Object.hasOwn(SEV, failOn)) {
  console.error(`plumb: invalid --fail-on value ${failOn}\n${usage}`);
  process.exit(2);
}
if (ruleFilter && !/^MER-[A-Z]{2}-\d{3}$/.test(ruleFilter)) {
  console.error(`plumb: invalid --rule value ${ruleFilter}\n${usage}`);
  process.exit(2);
}
if (packFilter && ([...packFilter].some((pack) => !PACKS.has(pack)) || packFilter.size === 0)) {
  console.error(`plumb: invalid --pack value ${[...packFilter].join(",")}\n${usage}`);
  process.exit(2);
}
if (baselineFile && writeBaselineFile) {
  console.error(`plumb: --baseline and --write-baseline cannot be used together\n${usage}`);
  process.exit(2);
}
if (!selfTest && !root) {
  console.error(usage);
  process.exit(2);
}

const timings = { setup: 0, inventory: [], astGrep: [], rules: [], producers: [], external: [], rendering: 0, counters: null };
const elapsed = (started) => performance.now() - started;
const ownerLabel = (owner) => `${owner.ids.join(",")} (${owner.source})`;
function emitProfile() {
  if (!profile) return;
  console.error(`plumb profile: setup ${timings.setup.toFixed(2)}ms`);
  for (const entry of timings.inventory) {
    console.error(`plumb profile: inventory ${entry.mode} ${entry.files} files ${entry.duration.toFixed(2)}ms`);
  }
  for (const entry of timings.astGrep) {
    console.error(`plumb profile: ast-grep [${entry.ids.join(",")}] ${entry.duration.toFixed(2)}ms`);
  }
  for (const entry of timings.rules) {
    console.error(`plumb profile: in-process ${ownerLabel(entry.owner)} ${entry.duration.toFixed(2)}ms`);
  }
  for (const entry of timings.producers) {
    console.error(`plumb profile: producer ${ownerLabel(entry.owner)} ${entry.duration.toFixed(2)}ms`);
  }
  for (const entry of timings.external) {
    const suffix = entry.skipped ? " skipped (--ci not enabled)" : ` ${entry.duration.toFixed(2)}ms`;
    console.error(`plumb profile: external-ci ${ownerLabel(entry.owner)}${suffix}`);
  }
  const externalTotal = timings.external.reduce((total, entry) => total + (entry.duration ?? 0), 0);
  if (timings.counters) {
    const counters = timings.counters;
    console.error(`plumb profile: counters text-read=${counters.textReads} line-map=${counters.lineMaps} json-parse=${counters.jsonParses} config-parse=${counters.configParses}`);
    console.error(`plumb profile: analysis-counters typescript-runtime-load=${counters.typescriptRuntimeLoads} typescript-parse=${counters.typescriptParses} vue-extraction=${counters.vueExtractions} vue-script-parse=${counters.vueScriptParses} tsconfig-discovery=${counters.tsconfigDiscoveries} tsconfig-parse=${counters.tsconfigParses} module-resolution=${counters.moduleResolutions} frontend-root-discovery=${counters.frontendRootDiscoveries} frontend-graph-build=${counters.frontendGraphBuilds} dependency-cruiser-load=${counters.dependencyCruiserLoads} dependency-cruiser-run=${counters.dependencyCruiserRuns} csharp-read=${counters.csharpTextReads} csharp-mask=${counters.csharpMasks} csharp-classification=${counters.csharpClassifications} dotnet-project-parse=${counters.dotnetProjectParses} dotnet-project-graph-build=${counters.dotnetProjectGraphBuilds} directory-build-props-parse=${counters.directoryBuildPropsParses}`);
    console.error(`plumb profile: capabilities ${Object.entries(counters.capabilityInitializations).map(([name, count]) => `${name}=${count}`).join(" ")}`);
  }
  console.error(`plumb profile: rendering ${timings.rendering.toFixed(2)}ms`);
  console.error(`plumb profile: external-ci total ${externalTotal.toFixed(2)}ms`);
  console.error(`plumb profile: total ${elapsed(invocationStarted).toFixed(2)}ms`);
}

function detectPacks(snapshot) {
  const packs = new Set(["TO", "CP"]);
  let csproj = false, modules = false, rivet = false, nuxt = false, tests = false, bts = false;
  const btsDomain = new Set(), btsApp = new Set();
  for (const file of snapshot.files) {
    if (file.path.split("/").length - 1 > 14) continue;
    const f = file.path, b = file.name;
    if (/^nuxt\.config\.(ts|js|mjs)$/.test(b)) nuxt = true;
    if (b.endsWith(".csproj")) {
      csproj = true;
      try { if (snapshot.text(file).includes("Rivet.Attributes")) rivet = true; } catch {}
    }
    if (b.endsWith(".cs")) {
      try { if (/\[Rivet(?:Contract|Endpoint|Client)\b/.test(snapshot.text(file))) rivet = true; } catch {}
    }
    if (f.includes("generated/rivet") || /contracts\/generated/.test(f)) rivet = true;
    if (f.includes("/Modules/") || f.startsWith("Modules/")) modules = true;
    if (/\.(spec|test)\.(ts|mjs|js)$/.test(b) || /Tests?\.csproj$/.test(b) ||
        f.includes("/tests/") || f.startsWith("tests/") || f.includes("__tests__") ||
        f.includes("/TestSupport/") || f.startsWith("TestSupport/")) tests = true;
    if (b.endsWith(".port.ts") || f.includes("application/ports/")) bts = true;
    // layer-shaped TS tree (lowercase domain/ + application|app/ under src/ or
    // modules/) is also a BT marker — glyphantics-style layered backends have no
    // ports dir but still carry the layer doctrine (contract §5, v7a)
    if (/(^|\/)(src|modules\/[^/]+)\/domain\//.test(f)) btsDomain.add(f.replace(/\/domain\/.*$/, ""));
    if (/(^|\/)(src|modules\/[^/]+)\/(application|app)\//.test(f)) btsApp.add(f.replace(/\/(application|app)\/.*$/, ""));
    if (b === "package.json") {
      try { if (snapshot.text(file).includes('"typed-inject"')) bts = true; } catch {}
    }
  }
  if (nuxt) packs.add("FE");
  if (csproj && modules) packs.add("BE");
  if (rivet) packs.add("RV");
  if (tests || (csproj && modules)) packs.add("TE");
  if (!bts) for (const d of btsDomain) if (btsApp.has(d)) { bts = true; break; }
  if (bts) packs.add("BT");
  return packs;
}

function runAstGrep(r, selected, allYaml) {
  if (!selected.length) return [];
  const args = selected.length === allYaml.length
    ? ["scan", "--config", SGCONFIG, "--json", "."]
    : ["scan", "--rule", selected[0].file, "--json", "."];
  const started = performance.now();
  const out = spawnSync("ast-grep", args, { cwd: r, encoding: "utf8", maxBuffer: 64 * 1024 * 1024 });
  timings.astGrep.push({ ids: selected.flatMap((owner) => owner.ids), duration: elapsed(started) });
  if (out.error) { console.error("plumb: ast-grep unavailable — YAML rules skipped"); return []; }
  let arr = [];
  try { arr = JSON.parse(out.stdout || "[]"); } catch { return []; }
  return arr.map((m) => ({
    id: m.ruleId,
    sev: m.severity === "warning" ? "warn" : (m.severity || "error"),
    loc: `${(m.file || "").replace(/^\.\//, "")}:${(m.range?.start?.line ?? 0) + 1}`,
    msg: m.message || "",
    ref: m.note || "",
  }));
}

function runChecks(r, selected, rivetVariant) {
  const findings = [];
  for (const owner of selected) {
    const started = performance.now();
    const out = spawnSync(owner.file, [path.resolve(r)], {
      encoding: "utf8", maxBuffer: 16 * 1024 * 1024,
      env: { ...process.env, ...(ci || selfTest ? { PLUMB_CI: "1" } : {}), PLUMB_RIVET_VARIANT: rivetVariant },
    });
    const duration = elapsed(started);
    (owner.ciOnly ? timings.external : timings.producers).push({ owner, duration });
    if (out.error || (out.status && out.status > 1)) {
      console.error(`plumb: check ${owner.source} failed: ${out.error?.message || out.stderr}`);
      continue;
    }
    if (out.stderr) process.stderr.write(out.stderr);
    for (const line of (out.stdout || "").split("\n")) {
      if (!line.trim()) continue;
      const [id, sev, loc, msg, ref = ""] = line.split("\t");
      if (id && sev && loc) findings.push({ id, sev, loc, msg: msg || "", ref });
    }
  }
  return findings;
}

const catalogStarted = performance.now();
let catalogue;
try { catalogue = loadRuleOwners(CHECKS, RULES, inProcessRules); }
catch (error) { console.error(`plumb: cannot load rule catalogue: ${error.message}`); process.exit(2); }
timings.setup += elapsed(catalogStarted);
const allYaml = catalogue.owners.filter((owner) => owner.kind === "yaml");

function selectedOwners(packs, rivetVariant = null, selectedRule = ruleFilter) {
  let selected = catalogue.owners;
  if (selectedRule) selected = selected.filter((owner) => owner.ids.includes(selectedRule));
  if (packFilter) selected = selected.filter((owner) => owner.ids.some((id) => packFilter.has(id.split("-")[1])));
  if (packs) selected = selected.filter((owner) => owner.ids.some((id) => packs.has(id.split("-")[1])));
  const ciEligible = ci || selfTest;
  for (const owner of selected) {
    if (owner.ciOnly && !ciEligible && !timings.external.some((entry) => entry.owner === owner)) {
      timings.external.push({ owner, duration: 0, skipped: true });
    }
  }
  selected = selected.filter((owner) => !owner.ciOnly || ciEligible);
  if (rivetVariant) selected = selected.filter((owner) => !owner.variants || owner.variants.includes(rivetVariant));
  return selected;
}

async function scan(r, { allPacks = false, selectedRule = ruleFilter } = {}) {
  const inventoryStarted = performance.now();
  const inventory = createRepositoryInventory(r);
  r = inventory.root;
  const snapshot = createRepositorySnapshot(inventory);
  const manifest = writeInventoryManifest(inventory);
  timings.inventory.push({ mode: inventory.mode, files: inventory.files.length, duration: elapsed(inventoryStarted) });
  const previousManifest = process.env.PLUMB_FILE_MANIFEST;
  const previousRoot = process.env.PLUMB_REPO_ROOT;
  process.env.PLUMB_FILE_MANIFEST = manifest.file;
  process.env.PLUMB_REPO_ROOT = inventory.root;
  try {
  const setupStarted = performance.now();
  const rivet = detectRivetContext(snapshot);
  const packs = allPacks || selectedRule ? null : detectPacks(snapshot);
  if (packs && rivet.variant !== "none") packs.add("RV");
  const visibility = createVisibility(r);
  const selected = selectedOwners(packs, rivet.variant, selectedRule);
  const selectedYaml = selected.filter((owner) => owner.kind === "yaml");
  const selectedScripts = selected.filter((owner) => owner.kind === "script");
  const selectedInProcess = selected.filter((owner) => owner.kind === "in-process");
  const capabilities = planCapabilities(selectedInProcess.map((owner) => owner.rule));
  timings.setup += elapsed(setupStarted);
  const inProcess = await runInProcessRules(snapshot, selectedInProcess.map((owner) => owner.rule), capabilities, {
    rivet,
    packs: packs ?? new Set(PACKS),
    staticInputs: {
      oxlintrc: () => fs.readFileSync(path.join(HOME, "configs", "oxlintrc.json"), "utf8"),
      oxfmtrc: () => fs.readFileSync(path.join(HOME, "configs", "oxfmtrc.json"), "utf8"),
      editorconfig: () => fs.readFileSync(path.join(HOME, "configs", "editorconfig.dotnet"), "utf8"),
    },
  });
  for (const entry of inProcess.timings) {
    const owner = selectedInProcess.find((candidate) => candidate.rule === entry.rule);
    timings.rules.push({ owner, duration: entry.duration });
  }
  for (const diagnostic of inProcess.diagnostics) process.stderr.write(`${diagnostic}\n`);
  timings.counters = snapshot.counters;
  let found = [...runAstGrep(r, selectedYaml, allYaml), ...inProcess.findings, ...runChecks(r, selectedScripts, rivet.variant)]
    .filter((f) => visibleFinding(r, visibility, f));
  if (packs) found = found.filter((f) => packs.has(f.id.split("-")[1]));
  if (ruleFilter) found = found.filter((f) => f.id === ruleFilter);
  if (packFilter) found = found.filter((f) => packFilter.has(f.id.split("-")[1]));
  found.sort((a, b) => SEV[b.sev] - SEV[a.sev] || a.id.localeCompare(b.id) || a.loc.localeCompare(b.loc));
  return found;
  } finally {
    if (previousManifest === undefined) delete process.env.PLUMB_FILE_MANIFEST;
    else process.env.PLUMB_FILE_MANIFEST = previousManifest;
    if (previousRoot === undefined) delete process.env.PLUMB_REPO_ROOT;
    else process.env.PLUMB_REPO_ROOT = previousRoot;
    manifest.cleanup();
  }
}

function visibleFinding(root, visibility, finding) {
  const rel = finding.loc.replace(/:\d+$/, "");
  if (!rel || rel === ".") return true;
  const abs = path.resolve(root, rel);
  try {
    if (!fs.statSync(abs).isFile()) return true;
  } catch {
    return true;
  }
  return shouldIncludeFile(root, visibility, abs);
}

if (selfTest) {
  let dirs = [];
  try { dirs = fs.readdirSync(FIXTURES).filter((d) => d.startsWith("MER-")); } catch {}
  let fail = 0;
  for (const id of dirs.sort()) {
    const hitBad = (await scan(path.join(FIXTURES, id, "bad"), { allPacks: true, selectedRule: id })).some((f) => f.id === id);
    const hitGood = (await scan(path.join(FIXTURES, id, "good"), { allPacks: true, selectedRule: id })).some((f) => f.id === id);
    const renderStarted = performance.now();
    if (hitBad && !hitGood) console.log(`ok   ${id}`);
    else { fail++; console.log(`FAIL ${id}  bad:${hitBad ? "hit" : "MISS"}  good:${hitGood ? "FALSE-POSITIVE" : "clean"}`); }
    timings.rendering += elapsed(renderStarted);
  }
  const renderStarted = performance.now();
  console.log(fail ? `self-test: ${fail}/${dirs.length} failing` : `self-test: all ${dirs.length} fixtures pass`);
  timings.rendering += elapsed(renderStarted);
  emitProfile();
  process.exit(fail ? 1 : 0);
}

const abs = path.resolve(root);
if (!fs.existsSync(abs)) { console.error(`plumb: no such directory ${abs}`); process.exit(2); }
let findings;
try { findings = await scan(abs); }
catch (error) { console.error(`plumb: inventory failed: ${error.message}`); process.exit(2); }

// --baseline ratchet (contract §5, 2026-06-11): count-per-(rule,path) allowance,
// findings over allowance are NEW; suppressed count is reported, never hidden.
const bKey = (f) => `${f.id}\t${f.loc.replace(/:\d+$/, "")}`;
if (writeBaselineFile) {
  const entries = {};
  for (const f of findings) entries[bKey(f)] = (entries[bKey(f)] || 0) + 1;
  fs.writeFileSync(writeBaselineFile, JSON.stringify({ version: 1, entries }, null, 2) + "\n");
  const renderStarted = performance.now();
  console.log(`plumb: baseline written — ${findings.length} findings across ${Object.keys(entries).length} (rule,path) keys`);
  timings.rendering += elapsed(renderStarted);
  emitProfile();
  process.exit(0);
}
let baselined = 0, baselineTotal = 0;
if (baselineFile) {
  let bl;
  try { bl = JSON.parse(fs.readFileSync(baselineFile, "utf8")); }
  catch (e) { console.error(`plumb: cannot read baseline ${baselineFile}: ${e.message}`); process.exit(2); }
  const allowance = { ...(bl.entries || {}) };
  baselineTotal = Object.values(allowance).reduce((a, b) => a + b, 0);
  findings = findings.filter((f) => {
    if (allowance[bKey(f)] > 0) { allowance[bKey(f)]--; baselined++; return false; }
    return true;
  });
}

const renderStarted = performance.now();
if (json) {
  console.log(JSON.stringify(findings.map((f) => ({ rule: f.id, severity: f.sev, location: f.loc, message: f.msg, docRef: f.ref })), null, 2));
} else {
  for (const f of findings) console.log(`${f.id}\t${f.sev}\t${f.loc}\t${f.msg}`);
  const c = { error: 0, warn: 0, info: 0 };
  for (const f of findings) c[f.sev] = (c[f.sev] || 0) + 1;
  let summary = `\nplumb: ${c.error} error, ${c.warn} warn, ${c.info} info`;
  if (baselineFile) {
    summary += ` (+${baselined} baselined, baseline holds ${baselineTotal})`;
    if (baselined < baselineTotal) summary += ` — shrunk; re-run --write-baseline to ratchet down`;
  }
  console.log(summary);
}
timings.rendering += elapsed(renderStarted);
emitProfile();
process.exit(findings.some((f) => SEV[f.sev] >= SEV[failOn]) ? 1 : 0);
